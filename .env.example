# Quickpass Backend Environment Configuration
# Rename to .env or .env.dev and update values for your setup

# Server
PORT=3000
NODE_ENV=development

# CORS origin for mobile/Flutter clients (required in production)
CORS_ORIGIN=http://localhost:8080

# PostgreSQL Local (override in .env.dev or .env.prod)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_CONNECTION=postgresql://postgres:YOUR_PASSWORD@localhost:5432/znc-quickpass
DB_SSL=false

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production

# Session
SESSION_EXPIRES_IN=7d
COOKIE_SECRET=change-this-to-a-different-random-secret

# QR Code
QR_SECRET=change-this-to-a-random-qr-secret
QR_VALIDITY_WINDOW_MINUTES=15

# Admin panel maintenance endpoints (migrate/seed/restart). Set to true ONLY in dev.
PANEL_ENABLED=true

# Optional HTTPS for mobile camera access
# HTTPS_KEY=/tmp/quickpass-key.pem
# HTTPS_CERT=/tmp/quickpass-cert.pem
# HTTPS_PORT=3443