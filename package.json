{
  "name": "quickpass",
  "version": "1.0.0",
  "private": true,
  "description": "Quickpass - Smart Gatepass & Leave Management",
  "scripts": {
    "dev": "NODE_ENV=dev bash dev.sh",
    "prod": "NODE_ENV=prod bash dev.sh",
    "dev:backend": "cd backend && npm run dev",
    "dev:web": "cd web && npx vite --host 0.0.0.0",
    "build:web": "cd web && npx vite build",
    "migrate": "cd backend && npx knex migrate:latest",
    "seed": "cd backend && npx knex seed:run",
    "desktop:dev": "cd admin-desktop && npm run dev",
    "desktop:build": "cd admin-desktop && npm run build",
    "setup:desktop": "powershell -ExecutionPolicy Bypass -File scripts/setup-desktop.ps1",
    "remove:desktop": "powershell -ExecutionPolicy Bypass -File scripts/remove-desktop.ps1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
