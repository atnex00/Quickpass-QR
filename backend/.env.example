# Quickpass backend environment configuration.
# You can use either:
#   - backend/.env  (base config, works for all environments)
#   - backend/.env.<NODE_ENV>  (overrides base config, e.g. .env.dev, .env.prod)
# If both exist, .env.<NODE_ENV> overrides values from .env.

# Server
PORT=3000
NODE_ENV=development

# CORS origin for mobile/Flutter clients (required in production)
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL
DB_CONNECTION=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DB_SSL=true

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# Session
SESSION_EXPIRES_IN=7d
COOKIE_SECRET=change-this-to-a-different-random-secret

# Firebase Cloud Messaging
FCM_TYPE=service_account
FCM_PROJECT_ID=your-project-id
FCM_PRIVATE_KEY_ID=your-private-key-id
FCM_PRIVATE_KEY=your-private-key
FCM_CLIENT_EMAIL=your-client-email
FCM_CLIENT_ID=your-client-id
FCM_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FCM_TOKEN_URI=https://oauth2.googleapis.com/token

# QR Code
QR_SECRET=change-this-to-a-random-qr-secret
QR_VALIDITY_WINDOW_MINUTES=15
