# Quickpass backend environment configuration.
# You can use either:
#   - backend/.env  (base config, works for all environments)
#   - backend/.env.<NODE_ENV>  (overrides base config, e.g. .env.dev, .env.prod)
# If both exist, .env.<NODE_ENV> overrides values from .env.

# Server
PORT=3000
NODE_ENV=development

# CORS origin for mobile/Flutter clients (required in production)
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL
DB_CONNECTION=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DB_SSL=true

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# Session
SESSION_EXPIRES_IN=7d
COOKIE_SECRET=change-this-to-a-different-random-secret

# QR Code
QR_SECRET=change-this-to-a-random-qr-secret
QR_VALIDITY_WINDOW_MINUTES=15

# Admin panel maintenance endpoints (migrate/seed/restart). Set to true ONLY in dev.
PANEL_ENABLED=false
