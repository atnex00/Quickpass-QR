PORT=3000
NODE_ENV=development
DB_CONNECTION=postgresql://postgres:admin@localhost:5432/passlynx
DB_SSL=false
JWT_SECRET=passlynx-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
SESSION_EXPIRES_IN=7d
QR_SECRET=passlynx-qr-dev-secret-change-in-production
QR_VALIDITY_WINDOW_MINUTES=15

# Firebase Cloud Messaging (optional — push notifications)
FCM_TYPE=service_account
FCM_PROJECT_ID=placeholder
FCM_PRIVATE_KEY_ID=placeholder
FCM_PRIVATE_KEY=placeholder
FCM_CLIENT_EMAIL=placeholder@example.com
FCM_CLIENT_ID=placeholder
FCM_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
